{
  "name": "my-way-of-evangelism",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker static assets project for My Way of Evangelism church discovery and digital evangelism platform.",
  "scripts": {
    "build": "exit 0",
    "preview": "node tools/static-server.mjs --root public --port 4173",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy public --project-name=my-way-of-evangelism",
    "tail": "wrangler tail my-way-of-evangelism"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
