{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-way-of-evangelism",
  "account_id": "17e900e2ac8567adf3e60c83fc64589e",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-way-of-evangelism",
      "database_id": "2a60c9f6-2850-4db3-9df3-ac80f69adb00"
    }
  ],
  "vars": {
    "APP_NAME": "My Way of Evangelism",
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://my-way-of-evangelism.doxalight-inc.workers.dev",
    "GOOGLE_CLIENT_ID": "744058453576-4v84hjrpkrun06tcnqn0ni8smuh6udgv.apps.googleusercontent.com",
    "OWNER_BOOTSTRAP_EMAIL": "churchoal@gmail.com"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_SECRET", "AUTH_ENCRYPTION_KEY"]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "2026091501", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "2026091502", "simple": { "limit": 30, "period": 60 } }
  ],
  "preview_urls": false,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "my-way-of-evangelism-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my-way-of-evangelism-preview",
          "database_id": "9d5c6215-602b-4641-bea9-dca104a1c3ba"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "2026091503", "simple": { "limit": 10, "period": 60 } },
        { "name": "WRITE_RATE_LIMITER", "namespace_id": "2026091504", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "APP_NAME": "My Way of Evangelism",
        "ENVIRONMENT": "preview",
        "PUBLIC_ORIGIN": "https://my-way-of-evangelism-preview.doxalight-inc.workers.dev",
        "GOOGLE_CLIENT_ID": "744058453576-4v84hjrpkrun06tcnqn0ni8smuh6udgv.apps.googleusercontent.com",
        "OWNER_BOOTSTRAP_EMAIL": "churchoal@gmail.com"
      },
      "secrets": {
        "required": ["AUTH_ENCRYPTION_KEY"]
      }
    }
  }
}
