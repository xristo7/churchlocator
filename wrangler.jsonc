{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-way-of-evangelism",
  "account_id": "431b9efd75ed20c548b4a06fe85960f0",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "My Way of Evangelism",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "my-way-of-evangelism-preview",
      "vars": {
        "APP_NAME": "My Way of Evangelism",
        "ENVIRONMENT": "preview"
      }
    }
  }
}
